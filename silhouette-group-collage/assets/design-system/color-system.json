  "scene_recipes": {
    "snow-winter": {
      "preferred": ["shepherds-red", "winter-plum", "saffron-cloth", "blue-smoke"],
      "avoid_dominant": ["heirloom-linen", "warm-bone"],
      "reason": "Keep silhouettes legible against snow while retaining wool-and-paper warmth."
    },
    "sea-sky": {
      "preferred": ["dried-persimmon", "butter-yellow", "saffron-cloth", "harbor-slate"],
      "avoid_dominant": ["lake-blue", "faded-denim"],
      "reason": "Use a warm counterpoint unless the source already has a strong warm clothing anchor."
    },
    "grass-garden": {
      "preferred": ["shepherds-red", "brick-rose", "butter-yellow", "muted-teal"],
      "avoid_dominant": ["garden-sage", "olive-leaf"],
      "reason": "Avoid losing the silhouette inside foliage; favour red, yellow, or teal separation."
    },
    "warm-indoor": {
      "preferred": ["hearth-smoke", "blue-smoke", "oxblood-wool", "butter-yellow"],
      "avoid_dominant": ["burnt-ochre", "oat-straw"],
      "reason": "Balance amber wood and firelight with smoke neutrals or one deep warm anchor."
    },
    "city-neutral": {
      "preferred": ["lake-blue", "brick-rose", "garden-sage", "butter-yellow"],
      "avoid_dominant": ["hearth-smoke", "warm-bone"],
      "reason": "Introduce one softened colour against concrete, glass, or pale walls."
    },
    "night-party": {
      "preferred": ["winter-plum", "burnt-ochre", "shepherds-red", "harbor-slate"],
      "avoid_dominant": ["pine-shadow", "oxblood-wool"],
      "reason": "Keep the paper field readable beside dark clothing and low exposure."
    },
    "sunset-road": {
      "preferred": ["saffron-cloth", "shepherds-red", "faded-denim", "winter-plum"],
      "avoid_dominant": ["burnt-ochre", "oat-straw"],
      "reason": "Echo sunset selectively without merging into the road or dry landscape."
    }
  },
  "usage_rules": {
    "candidate_roles": ["echo", "counterpoint", "atmosphere"],
    "dominant_paper_share": "40-60% of the complete page",
    "max_palette_colours": 3,
    "minimum_text_contrast": 3.0,
    "saturation_rule": "Prefer softened chroma; reject pure digital primaries and arbitrary neon colour.",
    "selection_rule": "Analyse the actual scene first, generate three candidates, then select one. Never reuse a favourite colour mechanically."
  }
}
